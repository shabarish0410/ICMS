# ── Frontend .dockerignore ──────────────────────────────────────────────────
# Prevents unnecessary files from being sent to the Docker build context,
# keeping the context small and build fast.

# Version control
.git
.gitignore
.github

# Editor
.vscode
.idea
*.swp
*.swo

# Dependencies (will be installed fresh in builder)
node_modules
.pnp
.pnp.js

# Build output (rebuilt in builder stage)
.next
out
dist
build

# Test & coverage
coverage
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (inject at runtime via docker-compose / orchestrator)
.env
.env.*
!.env.example

# Documentation
*.md
docs/

# OS files
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Misc
.eslintcache
.cache